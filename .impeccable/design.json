      "description": "Floating pill nav with the AAMA wordmark.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-mark\">AAMA</span><span class=\"ds-sep\">/</span><span class=\"ds-sec\">Chemmani</span><a class=\"ds-link\" href=\"#\">Sources</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;padding:8px 10px 8px 20px;border-radius:9999px;background:rgba(244,241,236,.74);backdrop-filter:blur(18px) saturate(140%);border:1px solid #DCD7CC;box-shadow:0 8px 32px -16px rgba(15,15,14,.18);max-width:560px}.ds-mark{font:300 19px Fraunces,serif;color:#1A3A39}.ds-sep{color:#A8A39A}.ds-sec{font:500 14px Inter,sans-serif;color:#2A2A28}.ds-link{margin-left:auto;font:500 14px Inter,sans-serif;color:#2A2A28;text-decoration:none;padding:8px 12px;border-radius:9999px}.ds-link:hover{background:#ECE7DE}.ds-link:focus-visible{outline:2px solid #2A78D6;outline-offset:2px}"
