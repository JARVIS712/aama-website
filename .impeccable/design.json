      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:40px;padding:8px 18px;border-radius:9999px;border:1px solid #BFB8A9;background:transparent;color:#0F0F0E;font:500 14px Inter,system-ui,sans-serif;cursor:pointer;transition:background-color .18s}.ds-btn-ghost:hover{background:#ECE7DE}.ds-btn-ghost:focus-visible{outline:2px solid #2A78D6;outline-offset:2px}"
    },
