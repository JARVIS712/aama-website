      "html": "<button class=\"ds-btn\">Open the original</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:8px 18px;border-radius:9999px;border:1px solid #0F0F0E;background:#0F0F0E;color:#F4F1EC;font:500 14px Inter,system-ui,sans-serif;cursor:pointer;transition:background-color .18s}.ds-btn:hover{background:#2A2A28}.ds-btn:focus-visible{outline:2px solid #2A78D6;outline-offset:2px}.ds-btn:active{transform:scale(.985)}"
