      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-on\" aria-pressed=\"true\">All grades</button><button class=\"ds-chip\" aria-pressed=\"false\">Court finding</button><button class=\"ds-chip\" aria-pressed=\"false\">News report</button></div>",
      "css": ".ds-chips{display:flex;gap:6px;flex-wrap:wrap}.ds-chip{font:12px/1.2 Inter,system-ui,sans-serif;padding:5px 10px;border-radius:9999px;background:#ECE7DE;color:#2A2A28;border:1px solid transparent;cursor:pointer}.ds-chip:hover{border-color:#BFB8A9}.ds-chip.ds-on{background:#0F0F0E;color:#F4F1EC}.ds-chip:focus-visible{outline:2px solid #2A78D6;outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "View switches such as Chart / Table.",
      "html": "<div class=\"ds-seg\" role=\"group\"><button class=\"ds-on\" aria-pressed=\"true\">Chart</button><button aria-pressed=\"false\">Table</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:3px;gap:2px;border-radius:9999px;background:#ECE7DE}.ds-seg button{border:0;background:transparent;padding:8px 15px;min-height:36px;border-radius:9999px;font:500 13.5px Inter,system-ui,sans-serif;color:#2A2A28;cursor:pointer}.ds-seg button.ds-on{background:#fff;color:#0F0F0E;box-shadow:0 1px 2px rgba(0,0,0,.12)}.ds-seg button:focus-visible{outline:2px solid #2A78D6;outline-offset:2px}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Content container on paper.",
      "html": "<div class=\"ds-card\"><div class=\"ds-eyebrow\">The numbers</div><h3 class=\"ds-title\">How the count grew</h3><p class=\"ds-body\">Each point is a figure as a source stated it, on the date it was stated.</p></div>",
      "css": ".ds-card{background:#fff;border:1px solid #DCD7CC;border-radius:18px;padding:24px;max-width:420px}.ds-eyebrow{font:500 11px Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#6B675E;margin-bottom:10px}.ds-title{font:300 26px/1.15 Fraunces,\"Times New Roman\",serif;letter-spacing:-.012em;color:#0F0F0E;margin:0 0 8px}.ds-body{font:400 15px/1.55 Inter,sans-serif;color:#4A4843;margin:0}"
    },
